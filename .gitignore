# environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# raw third-party data: re-download with `python -m src.download_data`
data/raw/

# large derived images (CC-BY RadPat re-renders, regenerate with src.preprocessing)
data/processed/radpat_images/

# model weights and cached features (regenerated by the training scripts)
results/checkpoints/
results/features/*
!results/features/vit_finetune_patch_perf_class_s42_*.npy
*.pt
*.joblib

# per-run stdout/stderr (queue.log is kept)
results/logs/*.out
results/logs/*.err

# office lock files
~$*
